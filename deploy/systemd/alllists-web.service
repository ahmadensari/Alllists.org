[Unit]
Description=AllLists web (gunicorn)
After=network.target postgresql.service

[Service]
User=alllists
Group=alllists
WorkingDirectory=/srv/alllists/current/backend
EnvironmentFile=/etc/alllists/alllists.env
ExecStart=/srv/alllists/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 30
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/alllists /var/log/alllists
PrivateTmp=true

[Install]
WantedBy=multi-user.target
