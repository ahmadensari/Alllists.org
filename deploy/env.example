# Copy to /etc/alllists/alllists.env on the server, chmod 600, owned by the service user. NEVER commit real values.
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=alllists.org,www.alllists.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://alllists.org,https://www.alllists.org
SITE_URL=https://alllists.org

POSTGRES_DB=alllists
POSTGRES_USER=alllists_app
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Field encryption (Fernet keys, comma separated "id:key"), the active key id, and the pepper for contact hashes.
FIELD_ENCRYPTION_KEYS=
FIELD_ENCRYPTION_ACTIVE_KEY=
CONTACT_HASH_PEPPER=

# Money and company details printed on invoices
COMPANY_NAME=
COMPANY_ADDRESS=
COMPANY_TAX_ID=
PAYMENT_INSTRUCTIONS=

# Operations
ALERT_EMAILS=
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EXTRACT_DIR=/var/lib/alllists/extracts

# AI work stays off until caps are set (minor units of the billing currency)
AI_DAILY_CAP_MINOR=0
AI_MONTHLY_CAP_MINOR=0
